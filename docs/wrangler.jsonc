{
  // Cloudflare Workers static-assets deployment for the Orion documentation.
  // No Worker script (`main`) — this is an assets-only Worker that serves the
  // mdBook output, so asset requests cost zero Worker invocations.
  //
  // Deployed by Cloudflare Workers Builds, the same mechanism as the
  // GoPlasmatic/website repo: the cloudflare-workers-and-pages GitHub App
  // watches this repo, and a push to `main` under docs/** makes Cloudflare
  // clone it, run the build command, and `wrangler deploy` from here. No
  // GitHub Actions workflow and no API-token secret are involved — the build
  // runs on Cloudflare's side, so nothing in GitHub needs credentials.
  //
  // These settings live in the Cloudflare dashboard rather than this file,
  // because Workers Builds owns them (Workers → orion-docs → Settings →
  // Build). Record of what they must be:
  //   • Git branch       : main
  //   • Root directory   : docs
  //   • Build command    : bash build.sh
  //   • Deploy command   : npx wrangler deploy
  //   • Include paths    : docs/*
  //   • Exclude paths    : docs/openapi.json
  //
  // Root directory is where BOTH commands run, which is why the build command
  // is `bash build.sh` and not `bash docs/build.sh` — the latter would look
  // for docs/docs/build.sh. (build.sh cd's to the repo root itself, so it
  // reads docs/src and writes docs/book either way, and `npx wrangler deploy`
  // finds this file and resolves ./book against it.)
  //
  // `bash` above is the recorded value, but the interpreter no longer has to
  // be right: a dashboard set to `sh build.sh` failed on the script's
  // `set -euo pipefail` (dash has no pipefail), so build.sh now re-execs
  // itself under bash when another shell starts it. Both spellings work.
  // Prefer `bash build.sh` anyway — it skips the re-exec and matches this
  // record.
  //
  // Watch paths are repository-relative, unlike the commands. The exclude is
  // load-bearing: openapi.json is regenerated whenever the API changes and is
  // not part of the published book, so without it every route change would
  // rebuild and redeploy the docs for nothing.
  //
  // Everything else — the mdBook version, llms-full.txt, the _redirects and
  // _headers staging — is deliberately inside docs/build.sh so it stays in the
  // repo and under review. `mdbook_pin_drift_test` holds the mdBook version
  // there equal to the one ci.yml checks pull requests with.
  "name": "orion-docs",
  "compatibility_date": "2025-08-01",
  // No public *.workers.dev mirror — the book is served on one hostname.
  "workers_dev": false,
  // custom_domain:true makes wrangler create the DNS record + edge cert on
  // deploy. The goplasmatic.io zone is already on Cloudflare with its apex
  // bound to the separate `website` Worker; Workers custom domains are
  // per-hostname, so this binding does not collide with it.
  "routes": [{ "pattern": "docs.goplasmatic.io", "custom_domain": true }],
  "assets": {
    "directory": "./book",
    // mdBook emits flat .html files and every internal link, the search index,
    // the book.toml redirect stubs and llms.txt all address them by name. The
    // default ("auto-trailing-slash") would 307 /foo.html → /foo on every one
    // of those, adding a redirect hop per click and desyncing the canonical
    // URL from every link we publish. "none" serves exact matches only, which
    // is byte-for-byte what GitHub Pages did before this.
    "html_handling": "none",
    // ...and because "none" means a bare "/" matches no file, the root is
    // served by the `/ → /index.html 200` proxy rule in cloudflare/_redirects.
    "not_found_handling": "404-page"
  }
}
