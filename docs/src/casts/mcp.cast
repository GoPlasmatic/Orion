[0.417, "o", "\u001b[2;37m# Claude Desktop / Cursor launch:  orion-cli mcp serve   (stdio, JSON-RPC)\u001b[0m\r\n"]
[1.234, "o", "\u001b[2;37m# Below is a real session — handshake, tool discovery, then a live tool call.\u001b[0m\r\n"]
[2.127, "o", "\u001b[2;37m# -> initialize\u001b[0m\r\n"]
[2.954, "o", "  connected to rmcp 1.4.0   (MCP protocol 2024-11-05)\r\n"]
[3.664, "o", "\u001b[2;37m# -> tools/list\u001b[0m\r\n"]
[4.496, "o", "  46 tools exposed to the AI, including:\r\n"]
[4.507, "o", "    channels_create               circuit_breakers_list         connectors_create         \r\n    data_send_async               data_send_sync                engine_reload             \r\n    functions_list                get_metrics                   health_check              \r\n    traces_list                   workflows_create              workflows_test            \r\n"]
[5.517, "o", "\u001b[2;37m# -> tools/call  data_send_sync(channel=orders, {order_id, total: 25000})\u001b[0m\r\n"]
[6.348, "o", "    {\r\n      \"alert\": \"High-value order: $25000\",\r\n      \"flagged\": true,\r\n      \"order_id\": \"ORD-9182\",\r\n      \"total\": 25000\r\n    }\r\n"]
[7.158, "o", "\u001b[2;37m# 46 tools, one server. Drop the config into your AI client and just ask.\u001b[0m\r\n"]
