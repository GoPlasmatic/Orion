    "/api/v1/admin/audit-logs": {
      "get": {
        "tags": [
          "Audit"
        ],
        "operationId": "list_audit_logs",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset (default 0)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, clamped to [1, 1000] (default 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit log entries with total count"
          }
        }
      }
    },
