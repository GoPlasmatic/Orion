{
  "workflow_id": "fan-into",
  "name": "fan-into",
  "tasks": [
    {
      "id": "fan",
      "name": "Fan",
      "condition": {
        "!": {
          "var": "temp_data.results"
        }
      },
      "for_each": {
        "over": [
          1,
          2
        ],
        "as": "it",
        "collect": "temp_data.one",
        "into": "temp_data.results"
      },
      "function": {
        "name": "crypto",
        "input": {
          "op": "hash",
          "data": {
            "var": "temp_data.it"
          },
          "output": "temp_data.one"
        }
      }
    },
    {
      "id": "after",
      "name": "After",
      "condition": {
        "!": {
          "var": "temp_data.results"
        }
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.flag",
              "logic": true
            }
          ]
        }
      }
    }
  ]
}
