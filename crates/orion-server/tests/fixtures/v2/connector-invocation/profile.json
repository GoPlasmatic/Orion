{
  "fixture_format_version": 1,
  "contract": "orion:connector@1.0.0",
  "schema_profile": "orion-json-schema/1",
  "targets": ["workflow", "rust-wasm", "second-language-wasm"],
  "default_call": {
    "binding": "primary",
    "operation": "contacts.get",
    "input": {"contact_id": "123"}
  },
  "default_context": {
    "deployment_revision": 41,
    "deadline_at_ms": 100,
    "connection_granted": true,
    "operation_granted": true,
    "egress_allowed": true
  },
  "bindings": {
    "primary": {
      "connection_id": "sales-crm",
      "connection_revision": 7,
      "base_url": "https://crm.invalid",
      "credential_identity": "fixture-credential-a",
      "synthetic_secret": "fixture-secret-a"
    },
    "alternate": {
      "connection_id": "support-crm",
      "connection_revision": 3,
      "base_url": "https://other-crm.invalid",
      "credential_identity": "fixture-credential-b",
      "synthetic_secret": "fixture-secret-b"
    }
  },
  "schemas": {
    "contact-request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["contact_id"],
      "additionalProperties": false,
      "properties": {"contact_id": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "contact-create": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["display_name"],
      "additionalProperties": false,
      "properties": {"display_name": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "contact": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["contact_id", "display_name"],
      "additionalProperties": false,
      "properties": {
        "contact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  },
  "operations": {
    "contacts.get": {
      "effect": "read", "retry": "safe",
      "input_schema": "contact-request", "output_schema": "contact",
      "method": "GET", "path": "/contacts/{contact_id}"
    },
    "contacts.create": {
      "effect": "write", "retry": "requires_key",
      "input_schema": "contact-create", "output_schema": "contact",
      "method": "POST", "path": "/contacts",
      "idempotency": {"header": "Idempotency-Key", "scope": "binding-and-operation", "deduplicate_equal_input": true}
    },
    "contacts.create_once": {
      "effect": "write", "retry": "never",
      "input_schema": "contact-create", "output_schema": "contact",
      "method": "POST", "path": "/contacts"
    },
    "contacts.compose": {
      "effect": "read", "retry": "safe",
      "input_schema": "contact-request", "output_schema": "contact",
      "method": "GET", "path": "/contacts/{contact_id}",
      "dependency_sequence": ["secondary", "secondary"]
    }
  },
  "dependencies": {
    "secondary": {"binding": "alternate", "operation": "contacts.get"}
  },
  "limits": {
    "max_attempts_per_invocation": 2,
    "max_total_attempts": 8,
    "retry_delay_ms": 10,
    "max_host_calls": 4,
    "max_depth": 2,
    "max_input_bytes": 4096,
    "max_output_bytes": 4096,
    "max_metadata_bytes": 1024,
    "max_error_bytes": 2048
  },
  "required_checks": [
    "root_revision_unchanged", "deadline_unchanged", "trace_lineage_preserved", "no_secret_leaks"
  ]
}
