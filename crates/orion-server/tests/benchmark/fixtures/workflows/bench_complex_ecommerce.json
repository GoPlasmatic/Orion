{
  "name": "Bench Complex Ecommerce",
  "condition": true,
  "tasks": [
    {
      "id": "parse",
      "name": "Parse Payload",
      "function": {
        "name": "parse_json",
        "input": {
          "source": "payload",
          "target": "input"
        }
      }
    },
    {
      "id": "vip_tier",
      "name": "VIP Classification",
      "condition": {
        ">=": [
          {
            "var": "data.input.amount"
          },
          500
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.tier",
              "logic": "vip"
            },
            {
              "path": "data.discount_pct",
              "logic": 20
            },
            {
              "path": "data.free_shipping",
              "logic": true
            }
          ]
        }
      }
    },
    {
      "id": "premium_tier",
      "name": "Premium Classification",
      "condition": {
        "and": [
          {
            ">=": [
              {
                "var": "data.input.amount"
              },
              100
            ]
          },
          {
            "<": [
              {
                "var": "data.input.amount"
              },
              500
            ]
          }
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.tier",
              "logic": "premium"
            },
            {
              "path": "data.discount_pct",
              "logic": 10
            },
            {
              "path": "data.free_shipping",
              "logic": false
            }
          ]
        }
      }
    },
    {
      "id": "standard_tier",
      "name": "Standard Classification",
      "condition": {
        "<": [
          {
            "var": "data.input.amount"
          },
          100
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.tier",
              "logic": "standard"
            },
            {
              "path": "data.discount_pct",
              "logic": 0
            },
            {
              "path": "data.free_shipping",
              "logic": false
            }
          ]
        }
      }
    },
    {
      "id": "enrich",
      "name": "Enrich Order",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.processed_at",
              "logic": {
                "now": []
              }
            },
            {
              "path": "data.label",
              "logic": {
                "cat": [
                  {
                    "var": "data.tier"
                  },
                  "-",
                  {
                    "var": "data.input.country"
                  }
                ]
              }
            },
            {
              "path": "data.priority",
              "logic": {
                "if": [
                  {
                    "in": [
                      {
                        "var": "data.input.country"
                      },
                      [
                        "US",
                        "UK",
                        "DE"
                      ]
                    ]
                  },
                  "high",
                  "normal"
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "workflow_id": "bench-complex-ecommerce"
}
