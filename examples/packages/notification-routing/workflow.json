{
  "workflow_id": "notification-routing",
  "tags": ["pkg:notification-routing"],
  "name": "Notification Router",
  "condition": true,
  "tasks": [
    {
      "id": "parse",
      "name": "Parse Payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "notification" } }
    },
    {
      "id": "log_all",
      "name": "Log All Notifications",
      "function": {
        "name": "map",
        "input": { "mappings": [{ "path": "data.notification.logged", "logic": true }] }
      }
    },
    {
      "id": "email",
      "name": "Send Email",
      "condition": { "!=": [{ "var": "data.notification.severity" }, "low"] },
      "function": {
        "name": "map",
        "input": { "mappings": [{ "path": "data.notification.email_sent", "logic": true }] }
      }
    },
    {
      "id": "sms",
      "name": "Send SMS for High/Critical",
      "condition": { "in": [{ "var": "data.notification.severity" }, ["high", "critical"]] },
      "function": {
        "name": "map",
        "input": { "mappings": [{ "path": "data.notification.sms_sent", "logic": true }] }
      }
    }
  ]
}
