{
  "workflow_id": "order-summary",
  "name": "Order Summary",
  "condition": true,
  "tasks": [
    {
      "id": "parse",
      "name": "Parse",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "summarize",
      "name": "Summarize",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.req.summary",
              "logic": {
                "cat": [
                  "Order ",
                  { "var": "data.req.order_id" },
                  ": $",
                  { "var": "data.req.total" }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
