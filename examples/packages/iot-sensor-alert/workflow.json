{
  "workflow_id": "iot-sensor-alert",
  "tags": ["pkg:iot-sensor-alert"],
  "name": "Sensor Alert Pipeline",
  "condition": true,
  "tasks": [
    {
      "id": "parse",
      "name": "Parse Payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "reading" } }
    },
    {
      "id": "critical",
      "name": "Mark Critical",
      "condition": {
        "or": [
          { ">": [{ "var": "data.reading.temperature" }, 90] },
          { "<": [{ "var": "data.reading.temperature" }, 0] }
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.reading.severity", "logic": "critical" },
            { "path": "data.reading.alert", "logic": true }
          ]
        }
      }
    },
    {
      "id": "warning",
      "name": "Mark Warning",
      "condition": {
        "and": [
          { ">": [{ "var": "data.reading.temperature" }, 70] },
          { "<=": [{ "var": "data.reading.temperature" }, 90] }
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.reading.severity", "logic": "warning" },
            { "path": "data.reading.alert", "logic": true }
          ]
        }
      }
    },
    {
      "id": "normal",
      "name": "Mark Normal",
      "condition": {
        "and": [
          { ">=": [{ "var": "data.reading.temperature" }, 0] },
          { "<=": [{ "var": "data.reading.temperature" }, 70] }
        ]
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.reading.severity", "logic": "normal" },
            { "path": "data.reading.alert", "logic": false }
          ]
        }
      }
    }
  ]
}
