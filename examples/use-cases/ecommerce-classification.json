{
  "name": "E-Commerce Order Classification",
  "description": "Classify orders by value tier with computed discounts using multi-workflow priority ordering",
  "workflows": [{ "file": "../packages/order-classification/workflow.json" }],
  "tests": [
    {
      "name": "VIP order gets tier and discount",
      "channel": "orders",
      "input": { "amount": 750, "product": "Diamond Ring" },
      "expect": {
        ".status": "ok",
        ".data.order.tier": "vip",
        ".data.order.discount_pct": "15",
        ".data.order.product": "Diamond Ring"
      }
    },
    {
      "name": "Premium order gets moderate discount",
      "channel": "orders",
      "input": { "amount": 250, "product": "Gold Watch" },
      "expect": {
        ".status": "ok",
        ".data.order.tier": "premium",
        ".data.order.discount_pct": "5"
      }
    },
    {
      "name": "Standard order gets no discount",
      "channel": "orders",
      "input": { "amount": 25, "product": "Sticker" },
      "expect": {
        ".status": "ok",
        ".data.order.tier": "standard",
        ".data.order.discount_pct": "0"
      }
    },
    {
      "name": "Boundary value at 500 is VIP",
      "channel": "orders",
      "input": { "amount": 500 },
      "expect": {
        ".status": "ok",
        ".data.order.tier": "vip",
        ".data.order.discount_pct": "15"
      }
    }
  ]
}
