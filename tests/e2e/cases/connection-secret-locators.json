{
  "name": "Connection Secret Locators",
  "description": "A connector's credential is written as an env:// reference. compile moves it into the connection's secret_locators, the node stores the reference, resolves it from its own environment when the connection is used, and the value appears in nothing the admin API answers.",
  "connectors": [
    {
      "name": "bearer-auth-api",
      "connector_type": "http",
      "config": {
        "type": "http",
        "url": "https://api.example.com/v1",
        "method": "POST",
        "auth": { "type": "bearer", "token": "env://E2E_CONNECTOR_BEARER_TOKEN" }
      }
    },
    {
      "name": "basic-auth-api",
      "connector_type": "http",
      "config": {
        "type": "http",
        "url": "https://api.example.com/v2",
        "method": "GET",
        "auth": {
          "type": "basic",
          "username": "admin",
          "password": "env://E2E_CONNECTOR_BASIC_PASSWORD"
        }
      }
    }
  ],
  "tests": [
    {
      "name": "A bearer token is stored as its reference",
      "read_connection": 0,
      "expect": {
        ".connection_id": "bearer-auth-api",
        ".secret_locators[\"auth.token\"]": "env://E2E_CONNECTOR_BEARER_TOKEN",
        ".public_config.auth.token": "null",
        "tostring | contains(\"super-secret-bearer-token-123\")": "false"
      }
    },
    {
      "name": "A basic-auth password is stored as its reference, the username in public config",
      "read_connection": 1,
      "expect": {
        ".connection_id": "basic-auth-api",
        ".secret_locators[\"auth.password\"]": "env://E2E_CONNECTOR_BASIC_PASSWORD",
        ".public_config.auth.username": "admin",
        "tostring | contains(\"s3cret-p4ss!\")": "false"
      }
    }
  ]
}
