{
    "name": "SSRF Protection",
    "description": "An http_call connector pointed at a private address is refused before any socket is opened, unless it opts out with allow_private_urls. This path used to be covered only by accident, by the unreachable-host case in http-error-handling.json, which asserted SSRF behaviour under a name that promised a connection failure.",
    "connectors": [
        {
            "name": "private-api",
            "connector_type": "http",
            "config": {
                "type": "http",
                "url": "http://127.0.0.1:19999",
                "method": "POST",
                "retry": {
                    "max_retries": 0,
                    "retry_delay_ms": 100
                }
            }
        }
    ],
    "workflows": [
        {
            "name": "SSRF Rejection Test",
            "priority": 10,
            "condition": true,
            "continue_on_error": true,
            "tasks": [
                {
                    "id": "parse",
                    "name": "Parse Payload",
                    "function": {
                        "name": "parse_json",
                        "input": { "source": "payload", "target": "req" }
                    }
                },
                {
                    "id": "call",
                    "name": "Call Private Address",
                    "function": {
                        "name": "http_call",
                        "input": {
                            "connector": "private-api",
                            "method": "POST",
                            "body": { "test": true },
                            "timeout_ms": 2000
                        }
                    }
                }
            ]
        }
    ],
    "tests": [
        {
            "name": "call to a private address is refused by SSRF protection",
            "channel": "ssrf-test",
            "input": { "action": "test-call" },
            "expect": {
                ".status": "ok",
                ".errors[0].code": "FUNCTION_ERROR",
                ".errors[0].task_id": "call",
                ".errors[0].message | contains(\"SSRF protection\")": "true",
                ".errors[0].message | contains(\"127.0.0.1\")": "true",
                ".data.req.action": "test-call"
            }
        }
    ]
}
