{
  "name": "HTTP Error Handling",
  "description": "Verify http_call behavior with continue_on_error when the target refuses the connection. allow_private_urls is what makes this test its own name: without it SSRF protection rejects 127.0.0.1 before a socket is ever opened, and the case silently becomes a duplicate of ssrf-protection.json.",
  "connectors": [
    {
      "name": "unreachable-api",
      "connector_type": "http",
      "config": {
        "type": "http",
        "url": "http://127.0.0.1:19999",
        "method": "POST",
        "allow_private_urls": true,
        "retry": { "max_retries": 0, "retry_delay_ms": 100 }
      }
    }
  ],
  "workflows": [
    {
      "name": "HTTP Call Error Test",
      "priority": 10,
      "condition": true,
      "continue_on_error": true,
      "tasks": [
        {
          "id": "parse",
          "name": "Parse Payload",
          "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
        },
        {
          "id": "call",
          "name": "Call Unreachable API",
          "function": {
            "name": "http_call",
            "input": {
              "connector": "unreachable-api",
              "method": "POST",
              "body": { "test": true },
              "timeout_ms": 2000
            }
          }
        }
      ]
    }
  ],
  "tests": [
    {
      "name": "HTTP call to unreachable host collects errors",
      "channel": "http-test",
      "input": { "action": "test-call" },
      "expect": {
        ".status": "ok",
        ".errors[0].code": "IO_ERROR",
        ".errors[0].task_id": "call",
        ".errors[0].message | contains(\"SSRF\") | not": "true",
        ".data.req.action": "test-call"
      }
    }
  ]
}
